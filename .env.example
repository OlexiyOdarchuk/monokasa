# Telegram bot token from @BotFather.
TG_TOKEN=

# HMAC key for reservation codes and QR signing. Random 32+ char string.
# DO NOT change after issuing tickets — existing QRs would invalidate.
TICKET_SECRET=

# Mono jar share link (https://send.monobank.ua/jar/<id>). Shown to buyers
# with amount/comment pre-filled via ?a=<UAH>&t=<code>.
MONO_JAR_LINK=

# Address monokasa listens on for the mono webhook (and the scanner UI).
HTTP_ADDR=:8090

# Optional: personal-API token (https://api.monobank.ua/). When set together
# with WEBHOOK_URL, the process auto-registers the webhook on startup via
# POST /personal/webhook. Without them, register once manually (curl or API).
MONO_TOKEN=

# Optional: public URL Mono will push events to. Must be reachable from the
# internet (cloudflared / ngrok / reverse proxy) and end with /webhook —
# that's the path auto-registration submits.
WEBHOOK_URL=https://your.domen.com/webhook

# SQLite DB file path.
DB_PATH=tix.db

# Show metadata. Use ISO 8601 with timezone for SHOW_STARTS_AT.
SHOW_TITLE=Моя вистава
SHOW_VENUE=Театральна площа
SHOW_STARTS_AT=2026-06-01T19:00:00+03:00
ROWS=5
COLS=6
PRICE_KOPECKS=25000

# How long a held-not-paid reservation stays valid.
HOLD=15m

# Reminder to ping paid buyers this far before the show.
REMIND_BEFORE=1h

# Optional: shared token gating /scan. Leave empty for local testing.
SCANNER_TOKEN=

# Optional: your Telegram user ID. Receives /stats. Find it via @userinfobot.
ADMIN_TG_ID=

# One-shot bootstrap for the admin web (/admin/login). Set BOTH to seed
# the first user on a fresh database; remove them from the environment
# after the first successful start. Subsequent boots ignore these values
# even if set — the DB is the source of truth.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Force Secure flag on session cookies. Set true when running behind
# HTTPS in production (the app also auto-detects TLS / X-Forwarded-Proto,
# so leave false for localhost dev).
SECURE_COOKIES=false
