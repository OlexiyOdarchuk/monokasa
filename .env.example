# Telegram bot token from @BotFather
TG_TOKEN=

# HMAC key for reservation codes and QR signing. Random 32+ char string.
# DO NOT change after issuing tickets — existing QRs would invalidate.
TICKET_SECRET=

# Mono jar share link (https://send.monobank.ua/<id>?Ps=...). Shown to buyers.
MONO_JAR_LINK=

# Where the mono webhook hits us. Expose this via cloudflared/ngrok tunnel
# and POST {"webHookUrl":"https://your-tunnel/webhook"} to
# https://api.monobank.ua/personal/webhook with X-Token: <your-mono-token>.
HTTP_ADDR=:8090

DB_PATH=tix.db

SHOW_TITLE=Моя вистава
SHOW_VENUE=Театральна площа
SHOW_STARTS_AT=2026-06-01T19:00:00+03:00
ROWS=5
COLS=6
PRICE_KOPECKS=25000

# How long a held-not-paid reservation stays valid.
HOLD=15m

# Optional: shared token gating /scan. Leave empty for local testing.
SCANNER_TOKEN=
